table matches
	lineageTag: 9a2302ff-f1e2-5e1a-a3a9-22035efbdeec

	measure 'Matches played' = COUNTROWS(matches)
		formatString: #,0
		lineageTag: 9c5ed9f6-fbf6-5d9b-a0d3-a9c2bf1055f7

	measure 'Total points' = SUM(matches[points])
		formatString: #,0
		lineageTag: 84be0bc2-b3c6-5c82-a097-c190c050f651

	measure 'Points per match' = DIVIDE([Total points], [Matches played])
		formatString: 0.00
		lineageTag: 1789c49a-933b-57bb-a6d2-e53361b404de

	measure 'Shot share' = DIVIDE(SUM(matches[shots_for]), SUM(matches[shots_for]) + SUM(matches[shots_against]))
		formatString: 0.0%
		lineageTag: f3eac9d0-a9d1-549d-a4ae-503af6aa9b71

	measure Conversion = DIVIDE(CALCULATE(SUM(matches[goals_for]), NOT ISBLANK(matches[shots_for])), SUM(matches[shots_for]))
		formatString: 0.0%
		lineageTag: c36cc29c-e6b6-5cf0-a0b9-68711a7e5221

	measure 'Shots per match' = AVERAGE(matches[shots_for])
		formatString: 0.0
		lineageTag: bf13dcc1-4d6f-5a80-a60c-3ea9fc333c99

	measure 'Shots conceded per match' = AVERAGE(matches[shots_against])
		formatString: 0.0
		lineageTag: 6d78b98c-13d7-5a4f-a512-a285a19567d2

	measure 'Brighton points per match' = CALCULATE([Points per match], matches[team] = "Brighton")
		formatString: 0.00
		lineageTag: c7315932-14ba-548f-a57c-07d7770fc16e

	measure 'League points per match' = CALCULATE([Points per match], REMOVEFILTERS(matches[team]))
		formatString: 0.00
		lineageTag: 55e48dff-a3a5-55e1-a3bc-8f3af5a6e799

	measure 'Brighton shot share' = CALCULATE([Shot share], matches[team] = "Brighton")
		formatString: 0.0%
		lineageTag: 9ef23a3d-f4d2-545b-a25c-bca4316fbcf8

	measure 'Even share' = 0.5
		formatString: 0%
		lineageTag: ea11f095-c24a-5c6b-a6f6-e2a96d7589f9

	measure 'Brighton conversion' = CALCULATE([Conversion], matches[team] = "Brighton")
		formatString: 0.0%
		lineageTag: 5314abcf-adc2-5a31-a13d-8206f64ada4a

	measure 'League conversion' = CALCULATE([Conversion], REMOVEFILTERS(matches[team]))
		formatString: 0.0%
		lineageTag: 3eccbf55-80ed-507b-a3b8-5106b8e97f91

	measure 'Brighton shots' = CALCULATE([Shots per match], matches[team] = "Brighton")
		formatString: 0.0
		lineageTag: 02bc6c00-0fc2-52dc-a527-66dd1accd7be

	measure 'Brighton shots conceded' = CALCULATE([Shots conceded per match], matches[team] = "Brighton")
		formatString: 0.0
		lineageTag: 8f6ce4c8-e121-5170-abb9-4bb810fd9990

	measure 'Latest season points per match' = VAR s = CALCULATE(MAX(matches[season]), REMOVEFILTERS(matches)) RETURN CALCULATE([Brighton points per match], matches[season] = s)
		formatString: 0.00
		lineageTag: e99d4d95-696e-54bc-ab11-3eef9905de67

	measure 'Latest season shot share' = VAR s = CALCULATE(MAX(matches[season]), REMOVEFILTERS(matches)) RETURN CALCULATE([Brighton shot share], matches[season] = s)
		formatString: 0.0%
		lineageTag: 405cc3e8-7533-5d4b-a0be-7f1a30ba1b76

	measure 'Latest season conversion' = VAR s = CALCULATE(MAX(matches[season]), REMOVEFILTERS(matches)) RETURN CALCULATE([Brighton conversion], matches[season] = s)
		formatString: 0.0%
		lineageTag: 18b7bf83-da58-5215-ac7c-5039a467e585

	measure 'Latest season matches' = VAR s = CALCULATE(MAX(matches[season]), REMOVEFILTERS(matches)) RETURN CALCULATE([Matches played], matches[season] = s, matches[team] = "Brighton")
		formatString: #,0
		lineageTag: 3f449738-16eb-578f-a1a1-2ecba2af651e

	column season
		dataType: string
		lineageTag: 1e8b1cd5-66be-5c82-aeb2-3f7056973c5e
		summarizeBy: none
		sourceColumn: season

	column match_date
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: cdbe0e54-2115-55d7-aba3-85effaf13aab
		summarizeBy: none
		sourceColumn: match_date

	column team
		dataType: string
		lineageTag: 36ac15c3-7f1b-5da2-aed8-13e711ca11e0
		summarizeBy: none
		sourceColumn: team

	column opponent
		dataType: string
		lineageTag: f00f6e09-043e-5d53-a267-1c5e6556cb4f
		summarizeBy: none
		sourceColumn: opponent

	column venue
		dataType: string
		lineageTag: 4a4581b8-5917-56ee-a278-16fc9519d5c1
		summarizeBy: none
		sourceColumn: venue

	column goals_for
		dataType: int64
		lineageTag: 7a9c048d-a089-59f4-a6c8-f3600d9a1c36
		summarizeBy: none
		sourceColumn: goals_for

	column goals_against
		dataType: int64
		lineageTag: 853f30db-d26f-59da-a59c-b69fd084b641
		summarizeBy: none
		sourceColumn: goals_against

	column points
		dataType: int64
		lineageTag: 5072c3c9-05e0-5919-a8d3-831217ad51b9
		summarizeBy: none
		sourceColumn: points

	column shots_for
		dataType: int64
		lineageTag: d3c94f5f-8ea8-54bc-a548-335f7711d966
		summarizeBy: none
		sourceColumn: shots_for

	column shots_against
		dataType: int64
		lineageTag: d697b63b-6a1a-5866-a318-770d736726ee
		summarizeBy: none
		sourceColumn: shots_against

	column sot_for
		dataType: int64
		lineageTag: 708a16f9-25f4-5a20-a1af-5bd730049294
		summarizeBy: none
		sourceColumn: sot_for

	column sot_against
		dataType: int64
		lineageTag: 999d93fe-1fc6-5b5f-a09b-2ae74e08c51a
		summarizeBy: none
		sourceColumn: sot_against

	column xg_for
		dataType: double
		lineageTag: 9790183e-2612-54e8-ae57-b62260fb4a1d
		summarizeBy: none
		sourceColumn: xg_for

	column xg_against
		dataType: double
		lineageTag: a8a1cb08-4bc6-5cf0-aeb8-cb7e410c4f9d
		summarizeBy: none
		sourceColumn: xg_against

	partition matches = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "matches.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"season", type text}, {"match_date", type date}, {"team", type text}, {"opponent", type text}, {"venue", type text}, {"goals_for", Int64.Type}, {"goals_against", Int64.Type}, {"points", Int64.Type}, {"shots_for", Int64.Type}, {"shots_against", Int64.Type}, {"sot_for", Int64.Type}, {"sot_against", Int64.Type}, {"xg_for", type number}, {"xg_against", type number}}, "en-US")
				in
				    Typed
