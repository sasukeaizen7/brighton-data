table trades
	lineageTag: b1b1b92d-b50a-5186-a01a-9023afeb5aeb

	measure 'Bought for (€M)' = DIVIDE(SUM(trades[buy_fee_eur]), 1000000)
		formatString: #,0.0
		lineageTag: 83ab5851-3f7b-5d8b-a167-2d0c96e70545

	measure 'Sold for (€M)' = DIVIDE(SUM(trades[sell_fee_eur]), 1000000)
		formatString: #,0.0
		lineageTag: 135897d4-277e-5f40-a5af-a644aedb9379

	measure 'Gain (€M)' = DIVIDE(SUM(trades[gain_eur]), 1000000)
		formatString: #,0.0
		lineageTag: 8a726290-ba85-544e-a875-f55de4bfdcb2

	measure 'Number of trades' = COUNTROWS(trades)
		formatString: #,0
		lineageTag: a5650b44-cf1a-5a0a-ada1-cf30e5969430

	column player
		dataType: string
		lineageTag: a5105ab7-ac90-5734-a349-22e44a5cced9
		summarizeBy: none
		sourceColumn: player

	column bought_season
		dataType: string
		lineageTag: b8b4bc21-f399-50ad-a427-7e0f29790acf
		summarizeBy: none
		sourceColumn: bought_season

	column buy_fee_eur
		dataType: int64
		lineageTag: c5d09ed7-f173-50cf-a2b0-6337bfea5b4f
		summarizeBy: none
		sourceColumn: buy_fee_eur

	column sold_season
		dataType: string
		lineageTag: 32aedbc9-4efe-5e90-a177-d2360181badf
		summarizeBy: none
		sourceColumn: sold_season

	column sold_to
		dataType: string
		lineageTag: c4fb6845-d7cb-5137-a0bc-ecefd1cc3f72
		summarizeBy: none
		sourceColumn: sold_to

	column sell_fee_eur
		dataType: int64
		lineageTag: b088e719-7e1f-5171-a5c0-fe0ddf657c08
		summarizeBy: none
		sourceColumn: sell_fee_eur

	column gain_eur
		dataType: int64
		lineageTag: aa0e7f97-0bd6-501f-a31e-78ce38590c65
		summarizeBy: none
		sourceColumn: gain_eur

	partition trades = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "trades.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"player", type text}, {"bought_season", type text}, {"buy_fee_eur", Int64.Type}, {"sold_season", type text}, {"sold_to", type text}, {"sell_fee_eur", Int64.Type}, {"gain_eur", Int64.Type}}, "en-US")
				in
				    Typed
